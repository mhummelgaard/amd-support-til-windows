<Window x:Class="Skaermlup.Desktop.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AmdWindow}"
        Title="Skærmlup — vejledning"
        Height="860" Width="900" MinHeight="500" MinWidth="640"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Primary}" Padding="22,16">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Sådan bruger du Skærmlup"/>
                <TextBlock Text="Alt kan gøres med musen. Alt kan også gøres med tastaturet."
                           FontSize="19" Foreground="{StaticResource OnDarkMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,2,0,0" Padding="22,14">
            <Button Style="{StaticResource PrimaryButton}" Content="Luk vejledningen"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,24">

                <Border Style="{StaticResource Card}" Background="{StaticResource Welcome}" BorderBrush="{StaticResource Accent}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Det korte af det lange"/>
                        <ItemsControl x:Name="Steps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="23" Margin="0,0,0,12"
                                               TextWrapping="Wrap" LineHeight="34"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="Sections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Heading}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="300"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}"
                                                            BorderBrush="{StaticResource Line}" BorderThickness="2"
                                                            CornerRadius="8" Padding="14,8" Margin="0,0,18,0"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Action}" FontSize="20"
                                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Primary}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Meaning}"
                                                               FontSize="20" TextWrapping="Wrap"
                                                               VerticalAlignment="Center" LineHeight="30"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Alle tastaturgenveje"/>
                        <ItemsControl x:Name="Keys">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="300"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="20"
                                                   FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="20"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
