<Window x:Class="Skaermlup.Desktop.Views.LensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skærmlup"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#FF101010"
        Left="-32000" Top="-32000" Width="480" Height="360">

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- Det forstørrede skærmbillede. Stretch="Fill" lader grafikkortet om selve
             opskaleringen, så processoren kun skal flytte det lille udsnit. -->
        <Image x:Name="Surface" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Markøren. Musepilen kommer ikke med i skærmkopien, så uden den her ville
             brugeren ikke kunne se hvor på skærmen luppen står. Linjerne stopper før
             ringen, så teksten lige under markøren ikke bliver dækket. -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Rectangle x:Name="CrossLeft"   StrokeThickness="2" Opacity="0.82"/>
            <Rectangle x:Name="CrossRight"  StrokeThickness="2" Opacity="0.82"/>
            <Rectangle x:Name="CrossTop"    StrokeThickness="2" Opacity="0.82"/>
            <Rectangle x:Name="CrossBottom" StrokeThickness="2" Opacity="0.82"/>
            <Ellipse   x:Name="RingOuter" StrokeThickness="7"/>
            <Ellipse   x:Name="RingInner" StrokeThickness="3"/>
        </Canvas>

        <!-- Rammen om luppen. Den gør det tydeligt hvor luppen holder op og skærmen
             begynder — ellers kan det forstørrede billede forveksles med skærmen selv. -->
        <Border x:Name="FrameRect" BorderBrush="#FFF5B301" BorderThickness="6" CornerRadius="10"/>
        <Ellipse x:Name="FrameCircle" Stroke="#FFF5B301" StrokeThickness="6" Visibility="Collapsed"/>
    </Grid>
</Window>
