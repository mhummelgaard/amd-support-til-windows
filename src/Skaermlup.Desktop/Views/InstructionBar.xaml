<Window x:Class="Skaermlup.Desktop.Views.InstructionBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skærmlup — vejledning"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Verdana, Segoe UI, Arial"
        Background="#FF000000"
        Left="-32000" Top="-32000" Width="1200" Height="160">

    <!-- Bjælken er hele pointen i "instruktioner skal være særligt synlige": sort bund,
         gul tekst, meget stor skrift, og den står der hele tiden — også når luppen er slukket,
         for ellers ville brugeren ikke kunne se hvordan man tænder den. -->
    <Border x:Name="Root" Background="#FF000000" BorderBrush="#FFF5B301" Padding="30,16,30,18">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,34,0">
                <TextBlock x:Name="Headline"
                           FontSize="32" FontWeight="Bold" Foreground="#FFFFD54F"
                           TextWrapping="NoWrap"/>
                <TextBlock x:Name="CallToAction"
                           FontSize="24" Foreground="#FFFFFFFF" Margin="0,4,0,0"
                           TextWrapping="Wrap" MaxWidth="620"/>
            </StackPanel>

            <ItemsControl x:Name="Chips" Grid.Column="1" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF161616" BorderBrush="#FF6E6E6E" BorderThickness="2"
                                CornerRadius="8" Padding="14,8" Margin="0,5,12,5">
                            <StackPanel>
                                <TextBlock Text="{Binding Action}" FontSize="19" FontWeight="Bold"
                                           Foreground="#FFFFD54F"/>
                                <TextBlock Text="{Binding Meaning}" FontSize="17" Foreground="#FFEDEDED"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
