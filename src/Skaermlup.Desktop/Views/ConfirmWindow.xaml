<Window x:Class="Skaermlup.Desktop.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AmdWindow}"
        Width="780" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Primary}" Padding="22,16">
            <TextBlock x:Name="Headline" Style="{StaticResource H1}" TextWrapping="Wrap"/>
        </Border>

        <!-- Den sikre knap står forrest, fyldt ud og med fokus. Den anden er rød og står for sig. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,2,0,0" Padding="22,14">
            <DockPanel>
                <Button x:Name="KeepButton" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsCancel="True" Click="OnKeep"/>
                <Button x:Name="ProceedButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right" Margin="14,0,0,0" Click="OnProceed"/>
            </DockPanel>
        </Border>

        <ItemsControl x:Name="Body" Margin="24,20,24,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding}" FontSize="22" Margin="0,0,0,14"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
