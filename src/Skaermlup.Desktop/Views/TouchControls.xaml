<Window x:Class="Skaermlup.Desktop.Views.TouchControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skærmlup — knapper"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Background="#FF000000"
        Left="-32000" Top="-32000" Width="120" Height="400">

    <!-- Knapperne til berøringsskærm. Samme gule på sort som vejledningsbjælken: det er
         programmets eget, og det skal kunne ses på enhver baggrund. Knapperne er store nok til
         en finger, der ikke rammer præcist — og de tager ikke fokus fra det program, man skriver i. -->
    <Window.Resources>
        <Style x:Key="TouchButton" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Verdana, Segoe UI, Segoe UI Symbol"/>
            <Setter Property="Foreground" Value="#FFFFD54F"/>
            <Setter Property="Background" Value="#FF161616"/>
            <Setter Property="BorderBrush" Value="#FF8A8A8A"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FFFFD54F"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="#FF000000" BorderBrush="#FFF5B301" BorderThickness="4"
            CornerRadius="14" Padding="10,10,10,0">
        <StackPanel>
            <Button x:Name="PowerButton" Style="{StaticResource TouchButton}" FontSize="30" Click="OnPower"/>
            <Button x:Name="ZoomInButton" Style="{StaticResource TouchButton}" Click="OnZoomIn"/>
            <Button x:Name="ZoomOutButton" Style="{StaticResource TouchButton}" Click="OnZoomOut"/>
            <Button x:Name="SettingsButton" Style="{StaticResource TouchButton}" Click="OnSettings"/>
        </StackPanel>
    </Border>
</Window>
