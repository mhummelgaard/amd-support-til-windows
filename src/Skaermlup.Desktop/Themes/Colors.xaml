<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Skærmlups farver. De står i deres egen fil, adskilt fra stilarterne i Amd.xaml, så de kan
         byttes ud med Windows' systemfarver, når et kontrasttema er slået til (ContrastTheme.cs).
         Stod de i samme fil som stilarterne, bandt WPF stilarterne fast til farverne, allerede
         når filen blev indlæst — og så kunne de ikke byttes bagefter. -->

    <SolidColorBrush x:Key="Primary"      Color="#00443C"/>
    <SolidColorBrush x:Key="PrimaryDark"  Color="#00302A"/>
    <SolidColorBrush x:Key="PrimarySoft"  Color="#C3D6D3"/>
    <SolidColorBrush x:Key="Accent"       Color="#F5B301"/>
    <SolidColorBrush x:Key="AccentDark"   Color="#B98700"/>
    <SolidColorBrush x:Key="Surface"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt"   Color="#EEF3F2"/>
    <SolidColorBrush x:Key="Line"         Color="#8C9C99"/>
    <SolidColorBrush x:Key="Ink"          Color="#0D1817"/>
    <SolidColorBrush x:Key="InkMuted"     Color="#3D4B49"/>
    <SolidColorBrush x:Key="OnDark"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Danger"       Color="#96001B"/>
    <SolidColorBrush x:Key="DangerSoft"   Color="#FBE7EA"/>
    <SolidColorBrush x:Key="WarningBg"    Color="#FFF6DA"/>
    <SolidColorBrush x:Key="Welcome"      Color="#FFF9E9"/>
    <SolidColorBrush x:Key="OnDarkMuted"  Color="#D6E4E1"/>
    <SolidColorBrush x:Key="OnDangerMuted" Color="#FFE8E4"/>

</ResourceDictionary>
