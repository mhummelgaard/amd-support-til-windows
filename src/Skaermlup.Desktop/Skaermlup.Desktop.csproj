<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Skærmbilledet kopieres direkte fra en DIB-buffer over i visningen. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Byg med -p:UiAccess=true for en signeret udgave der maa ligge oven paa Start-menuen. -->
    <ApplicationManifest Condition="'$(UiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\skaermlup.ico</ApplicationIcon>
    <RootNamespace>Skaermlup.Desktop</RootNamespace>
    <AssemblyName>Skaermlup</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyTitle>Skaermlup - forstoerrelsesglas til skaermen</AssemblyTitle>
    <Company>Michael Hummelgaard</Company>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skaermlup.Core\Skaermlup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\skaermlup.ico" />
  </ItemGroup>

</Project>
