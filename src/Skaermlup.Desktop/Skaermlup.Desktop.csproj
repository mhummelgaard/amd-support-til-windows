<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Kun til ikonet ved uret, som WPF ikke selv har. En del af den samme .NET-pakke —
         ingen ekstra afhængighed. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 råder Windows Forms-programmer til at sætte DPI i koden frem for i manifestet.
         Det her er et WPF-program, og luppen regner i rigtige skærmpixels: DPI skal være på plads,
         før det første vindue findes, og det er netop hvad manifestet sikrer. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Skærmbilledet kopieres direkte fra en DIB-buffer over i visningen. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Byg med -p:UiAccess=true for en signeret udgave der maa ligge oven paa Start-menuen. -->
    <ApplicationManifest Condition="'$(UiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\skaermlup.ico</ApplicationIcon>
    <RootNamespace>Skaermlup.Desktop</RootNamespace>
    <AssemblyName>Skaermlup</AssemblyName>
    <Version>1.7.0</Version>
    <AssemblyTitle>Skaermlup - forstoerrelsesglas til skaermen</AssemblyTitle>
    <Company>Michael Hummelgaard</Company>
    <!-- Står i filens egenskaber i Stifinder. Gratis for alle — men udvikleren skal fremgå. -->
    <Authors>Michael Hummelgaard</Authors>
    <Product>Skærmlup</Product>
    <Copyright>© 2026 Michael Hummelgaard · Gratis for alle (MIT-licens)</Copyright>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms ville ellers importere sine navne i alle filer, og de støder sammen med
         WPF's: Application, Button, MessageBox. Den ene fil, der bruger dem, siger det selv. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skaermlup.Core\Skaermlup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\skaermlup.ico" />
  </ItemGroup>

</Project>
